# Execute npm run setup para criar estas duas variáveis com senha protegida por scrypt.
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=
# Diretório persistente e exclusivo do servidor.
DATA_DIR=./data
# Produção exige HTTPS. Para desenvolvimento local apenas, use false.
COOKIE_SECURE=true
# Necessário atrás de proxy reverso se a origem interna diferir da origem do navegador.
APP_ORIGIN=https://discovery.seudominio.com.br
