{
	email {$ACME_EMAIL}
	admin off
}

{$DOMAIN} {
	encode zstd gzip
	header Strict-Transport-Security "max-age=31536000"
	@xmlUpload path /api/xml/analyze
	handle @xmlUpload {
		request_body {
			max_size 3MB
		}
		reverse_proxy app:3000
	}
	handle {
		request_body {
			max_size 150KB
		}
		reverse_proxy app:3000
	}
}
